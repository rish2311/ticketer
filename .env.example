# ============================================
# Distributed Flash Sale Ticket Booking Engine
# Environment Configuration
# ============================================

# PostgreSQL
POSTGRES_USER=ticketer
POSTGRES_PASSWORD=ticketer_secret
POSTGRES_DB=ticketer_db
POSTGRES_PORT=5432

# PgBouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=1000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_ORDERS=order-pending
KAFKA_TOPIC_DLQ=order-dlq
KAFKA_GROUP_ID=order-workers

# API Gateway
API_PORT=8080
TICKET_INVENTORY=100
LOCK_TTL_SECONDS=300

# Order Worker
WORKER_PAYMENT_SUCCESS_RATE=80
WORKER_MAX_RETRIES=3
WORKER_CONSUMER_COUNT=5
WORKER_METRICS_PORT=9091

# Observability
JAEGER_ENDPOINT=http://jaeger:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
